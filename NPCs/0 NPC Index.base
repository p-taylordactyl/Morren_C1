filters:
  and:
    - type == "npc"
    - file.folder != "admin/templates"
views:
  - type: cards
    name: All
    order:
      - file.name
      - brief
      - locations
      - organizations
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      note.brief: 454
    image: note.cover
    imageAspectRatio: 1.3
    imageFit: contain
    cardSize: 240
  - type: cards
    name: Organizations-embedonly
    filters:
      and:
        - organizations.contains(link(this.file))
    order:
      - file.name
      - brief
      - locations
      - associates
    image: note.cover
    cardSize: 240
    imageAspectRatio: 1.1
  - type: cards
    name: Location-embedonly
    filters:
      and:
        - locations.contains(link(this.file.name))
    order:
      - file.name
      - brief
    image: note.cover
    cardSize: 240
    imageAspectRatio: 1.15
  - type: cards
    name: Groups-embedonly
    filters:
      and:
        - organizations.contains(link(this.file.name))
    image: note.cover
