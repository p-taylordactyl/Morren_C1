filters:
  and:
    - type == "quest"
    - file.folder != "admin/templates"
views:
  - type: table
    name: All
    groupBy:
      property: quest_status
      direction: ASC
    order:
      - file.name
      - quest_status
      - quest_location
      - quest_giver
      - expires
      - reward
      - tags
    sort:
      - property: file.name
        direction: DESC
      - property: due_date
        direction: ASC
    columnSize:
      note.quest_location: 154
  - type: table
    name: Completed
    filters:
      and:
        - quest_status == "completed"
    order:
      - file.name
      - quest_location
      - quest_giver
      - quest_status
      - expires
      - tags
    sort:
      - property: due_date
        direction: ASC
    columnSize:
      note.due_date: 94
      note.quest_location: 270
      note.quest_giver: 272
  - type: table
    name: In-Progress
    filters:
      or:
        - quest_status == "active"
        - quest_status == "turn in"
    order:
      - file.name
      - quest_location
      - quest_giver
      - quest_status
      - expires
      - reward
      - tags
    columnSize:
      note.quest_giver: 160
      note.quest_location: 270
  - type: table
    name: Available
    filters:
      and:
        - quest_status == "available"
    order:
      - file.name
      - quest_location
      - quest_giver
      - quest_status
      - expires
      - reward
      - tags
    columnSize:
      note.quest_giver: 160
      note.quest_location: 270
  - type: table
    name: ByNPC
    filters:
      and:
        - file.hasLink(this.file)
    groupBy:
      property: quest_status
      direction: ASC
    order:
      - file.name
      - quest_status
      - quest_location
      - quest_giver
      - expires
      - reward
      - tags
    sort:
      - property: file.name
        direction: DESC
      - property: due_date
        direction: ASC
    columnSize:
      note.quest_location: 154
  - type: table
    name: location-embedonly
    filters:
      and:
        - quest_location.contains(link(this.file.name))
    order:
      - file.name
      - quest_status
      - quest_giver
      - quest_location
      - expires
      - reward
      - tags
    sort:
      - property: quest_location
        direction: ASC
    columnSize:
      note.quest_location: 154
