filters:
  and:
    - type == "npc"
    - file.folder != "admin/templates"
views:
  - type: cards
    name: All NPCs
    order:
      - file.name
      - brief
      - locations
      - organizations
    sort:
      - property: file.backlinks
        direction: DESC
    columnSize:
      note.brief: 454
    image: note.cover
    imageAspectRatio: 1.05
  - type: cards
    name: Faction - embedonly
    filters:
      and:
        - organizations.contains(link(this.file.name))
    order:
      - file.name
      - brief
      - locations
      - associates
    image: note.cover
  - type: cards
    name: Location - embedonly
    filters:
      and:
        - locations.contains(link(this.file.name))
    order:
      - file.name
      - brief
    image: note.cover
    cardSize: 170
    imageAspectRatio: 1.15
  - type: cards
    name: Groups - embedonly
    filters:
      and:
        - associations.contains(link(this.file.name))
    image: note.img
  - type: cards
    name: NPC by Organization
    order:
      - file.name
      - brief
      - locations
      - organizations
    image: note.cover
    imageAspectRatio: 1.25
