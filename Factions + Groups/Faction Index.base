filters:
  and:
    - type.containsAny("faction","group")
    - file.folder != "admin/templates"
formulas:
  Untitled: ""
  backlinks: "if "
views:
  - type: cards
    name: All Factions + Groups
    order:
      - file.name
      - locations
      - associations
    image: note.cover
    rowHeight: tall
  - type: cards
    name: Corporate
    filters:
      and:
        - type.contains("corporate faction")
    image: note.cover
    imageAspectRatio: 1.15
  - type: cards
    name: Undergound
    filters:
      and:
        - type == "underground faction"
    order:
      - file.name
      - locations
      - associations
    image: note.cover
    rowHeight: tall
