filters:
  and:
    - type == "session_note"
    - file.folder != "admin/templates"
properties:
  file.name:
    displayName: Session
  note.locations:
    displayName: session locations
views:
  - type: table
    name: All
    order:
      - file.name
      - session_date
      - missed
      - ingame_start
      - ingame_finish
      - locations
    columnSize:
      file.name: 111
  - type: table
    name: Encounters
    filters:
      and:
        - file.hasLink(this.file)
    order:
      - file.name
      - locations
  - type: cards
    name: Prev-and-Next-Sessions
    filters:
      or:
        - session_number == this.session_number - 1
        - session_number == this.session_number + 1
    order:
      - session_date
      - file.name
    cardSize: 280
