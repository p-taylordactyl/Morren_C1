filters:
  and:
    - type.contains("location")
    - file.folder != "admin/templates"
formulas:
  Untitled: ""
views:
  - type: table
    name: All
    groupBy:
      property: factions
      direction: ASC
    order:
      - file.name
      - district
      - parent
      - associations
      - formula.Untitled
    image: note.cover
    columnSize:
      file.name: 186
    rowHeight: tall
  - type: list
    name: Sublocations-embed
    filters:
      and:
        - parent.contains(link(this.file.name))
    indentProperties: true
  - type: table
    name: District-embedonly
    filters:
      and:
        - district.contains(link(this.file.name))
    groupBy:
      property: district
      direction: ASC
